{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "dg hooks deny-command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-fixme.sh \"$CLAUDE_FILE_PATH\""
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-code.sh"
          }
        ]
      }
    ]
  }
}

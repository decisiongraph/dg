{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "dg hooks deny-command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "dg hooks check-fixme \"$CLAUDE_FILE_PATH\""
          },
          {
            "type": "command",
            "command": "dg hooks check-code \"$CLAUDE_FILE_PATH\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "dg hooks stop"
          }
        ]
      }
    ]
  }
}
